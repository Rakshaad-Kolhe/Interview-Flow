# Server Configuration
PORT=5000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5433/interviewflow?schema=public

# MongoDB (Mongoose)
MONGODB_URI=mongodb://root:example@localhost:27018/interviewflow?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here

# Third Party APIs
LLM_API_KEY=your_llm_api_key_here
PAYMENT_SECRET_KEY=your_payment_secret_key_here
THIRD_PARTY_API_KEY=your_third_party_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
